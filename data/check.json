    {"id": "accent", "patterns": ["^(primary|brand)$", "^accent$"], "name_de": "Akzent", "name_en": "Accent"},
    {"id": "on-accent", "patterns": ["^(on-primary|primary-foreground)$", "^(on-accent|accent-foreground)$"], "name_de": "Schrift für Akzent", "name_en": "Text for accent"},
